{
  "tracker": {
    "type": "linear",
    "team": "MLG",
    "project": "MLG",
    "ticketPrefix": "MLG",
    "ticketIdPattern": "^MLG-\\d+$",
    "statuses": {
      "inProgress": "In Progress",
      "inReview": "In Review",
      "done": "Done"
    }
  },
  "git": {
    "baseBranch": "main",
    "remote": "origin",
    "branchPrefixes": {
      "feature": "feature",
      "fix": "fix",
      "chore": "chore",
      "refactor": "refactor"
    }
  },
  "epics": {
    "enabled": true,
    "branchPrefix": "epic"
  },
  "pullRequest": {
    "automation": "gh",
    "reviewers": [
      {
        "email": "person@example.com",
        "githubHandle": "alice"
      }
    ],
    "skipSelfReview": true
  },
  "commitSkill": {
    "name": "commit"
  },
  "delegation": {
    "commitMessage": {
      "enabled": true,
      "models": {
        "claude": "haiku",
        "codex": "gpt-5.1-codex-mini",
        "cursor": "composer-1"
      }
    }
  },
  "handoff": {
    "commit": true,
    "push": true,
    "pullRequest": true
  },
  "requireTicket": true,
  "skillSelection": {
    "askBeforeImplementation": true,
    "mode": "ask"
  },
  "timeTracking": {
    "enabled": true,
    "outputFormat": "default",
    "storage": "repo"
  }
}
